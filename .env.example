# Local development: embedded PostgreSQL. Production Compose overrides this URL.
DATABASE_URL=pglite:data/backend
INTERNAL_TOKEN=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: register commands instantly in one development server.
DISCORD_GUILD_ID=
BACKEND_PUBLIC_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Production: use a random hexadecimal password and a real DNS name.
DB_PASSWORD=
PUBLIC_HOST=
# Sessions use random, hashed database tokens. Collector uses Windows DPAPI.
# Reserved for deployments that add a separate session/encryption provider.
SESSION_SECRET=
ENCRYPTION_KEY=
